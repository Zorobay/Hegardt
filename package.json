{
  "name": "hegardt-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "vue",
    "sebastian",
    "shared"
  ],
  "scripts": {
    "lint": "npm run lint:js && npm run lint:style",
    "lint:js": "eslint . --fix",
    "lint:style": "stylelint \"{vue,sebastian,shared}/src/**/*.{css,scss,vue}\" --fix",
    "format": "prettier --write \"{vue,sebastian,shared}/src/**\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-vue": "^2.0.0",
    "typescript-eslint": "^8.71.1",
    "vue-eslint-parser": "^10.4.1"
  }
}